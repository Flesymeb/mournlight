355","output_contract":{"criterion_statuses":["fail","pass"],"finding_optional_fields":{"details":"Small JSON object for MCP/runtime facts needed by the next Planner/Developer, such as node_path, mcp_tool, screenshot_id, observed_transform.position, observed_transform.rotation_degrees, expected_transform, and retest_recipe."},"finding_severities":["blocker","major","minor","note"],"may_only_cite_bound_evidence":true,"must_echo_bindings":true,"must_review_every_criterion_once":true,"optional_fields":["verified_issue_ids","still_open_issue_ids","insufficient_evidence_issue_ids"],"pass_requires":{"all_criteria_pass":true,"blocking_focus_empty":true,"forbidden_finding_severities":["blocker","major"]},"required_fields":["schema_version","status","bindings","criteria","blocking_focus","preserve","findings"],"schema_version":1,"statuses":["fail","pass"]},"promotion_eligible":true,"purpose":"formal_quality","repair_verification":null,"required_criteria":[{"id":"release_convergence_review","requirement":"Review candidate-bound runtime evidence against the PRD requirements for phase release_convergence."},{"id":"release_convergence_camera_movement_dash_contract","requirement":"Use ordinary keyboard and gamepad-equivalent input to verify camera-relative planar movement, collision sliding, visual facing, dash anticipation/invulnerability/recovery/cooldown, high-angle camera framing and clean pause/resume. Judge only behavior introduced by the active phase; reject hidden threats, contradictory velocity, stuck input or camera modes that drift toward FPS/TPS play."},{"id":"release_convergence_automatic_combat_causality_contract","requirement":"Bind one stable event chain from cooldown and deterministic legal target selection through emitted attack, hit policy, damage, hurt, exactly-once death and drop. Require visible and audible anticipation, onset, impact and recovery without manual-fire drift, duplicate damage, freed targets, inert attacks or presentation disconnected from state."},{"id":"release_convergence_enemy_spawn_motion_fairness_contract","requirement":"Exercise active enemy roles from validated off-camera spawn through approach, separation, telegraph, attack, hurt, death, drop and pool return. Reject collision or out-of-bounds spawns, root sliding, static poses, first-frame damage, unreadable overlap, dead actors moving, permanent clumps, blocked escape lanes and stale pooled state."},{"id":"release_convergence_experience_upgrade_transaction_contract","requirement":"Verify enemy reward, collection, experience threshold and overflow, one paused three-choice draft, debounced selection, authoritative build mutation and resumed play with an observable changed attack or utility. Reject duplicate drafts, held-confirm double choice, blank/inert cards, false values, lost overflow or gameplay clocks advancing under draft."},{"id":"release_convergence_survivor_hud_presentation_contract","requirement":"Require every introduced health, experience, level, wave/run, weapon, dash and boss field to match authoritative runtime state while leaving the arena readable. Judge native, fullscreen and supported UI scales; reject default fonts, debug labels, text piles, opaque blue/purple blocks, generic rounded cards, clipped controls and top-left-only pages."},{"id":"release_convergence_run_lifecycle_restart_contract","requirement":"From title through gameplay, pause, player failure and retry, verify single authoritative run transitions and a clean baseline after three restarts. Reject stale actors, timers, signals, pools, pause reasons, input ownership, attacks, effects or audio, and any state that requires restarting the application to recover."},{"id":"release_convergence_recapture_evidence_binding","requirement":"Bind black-box ordinary play and white-box authoritative snapshots, events, transforms, animation/audio owners, logs and distributed frames to the exact candidate. Deterministic setup may reach legal branches, but normal runtime systems and input must cause the accepted outcome."},{"id":"release_convergence_weapon_build_identity_contract","requirement":"Exercise every weapon and representative upgrade path. Require focused bolts, close sweep and orbiting area control to retain distinct targeting, cadence, geometry, hit policy, feedback and build consequences rather than renamed copies of one projectile."},{"id":"release_convergence_wave_director_boss_contract","requirement":"Verify five data-driven wave states, composition escalation, elite pressure and the Bellkeeper's two phases, telegraphs, summons or lane pressure, recovery window, exactly-once defeat and victory. The director must honor live caps and stop after terminal state."},{"id":"release_convergence_authored_cemetery_composition_contract","requirement":"Compare ordinary runtime views with the frozen Mournlight visual reference. Require one coherent bounded cemetery, grounded collision, keeper post, mausoleum and cracked bell landmarks, clear escape lanes, readable silhouettes, coherent scale/materials and no visible stand-ins."},{"id":"release_convergence_animation_vfx_lighting_audio_contract","requirement":"Inspect accepted component/source values and every active animation state, moonlight/lantern hierarchy, causal bounded VFX and semantic audio layer under real crowd density. Reject unrelated fallback clips, sliding/dead movement, overdark or clipped light, leaked loops, hum, unexpected speech, generic tones and effects that hide telegraphs."},{"id":"release_convergence_product_shell_accessibility_contract","requirement":"Navigate title, settings, upgrade, pause, death, victory and result pages across the full viewport with mouse, keyboard and gamepad focus. Verify persisted audio/window/UI-scale/effect settings, authored iconography and typography, truthful summaries and clean replay/title flow."},{"id":"release_convergence_dense_run_performance_contract","requirement":"Profile the representative final wave and boss at 1920x1080 with 25-40 ordinary enemies, all weapon families, pickups, animation, VFX, lights, UI and audio. Require stable frame-time distribution, bounded high-churn work and no growth across three complete retries."},{"id":"release_convergence_complete_run_release_contract","requirement":"Play the complete seven-to-ten-minute title-to-result run, including failure and victory branches, three viable build shapes, statistics, credits/provenance and replay. Reject placeholders, debug presentation, missing required content or unresolved release-relevant regressions."}],"schema_version":2},"tester_invocation_sha256":"bf51bea46aeeecb63628699f22741ec83196cac50d439a67da2c79579bc99de6","tester_review":{"path":"evaluations/loop-72-cc9383df6931/phase-1788020902690449837/tester_review.json","sha256":"6d565669182dda6c8eaf8462b067c0cba31730200c50e45aab8816a04791b373","status":"fail"}},"quality_plan":"[redacted private Runtime detail]","runtime":"local-godot","schema_version":4,"scope":"phase","source":"gameloop.e2e.quality-final","started_unix_ns":1788020902847209973,"state_before_sha256":"831f7f6697e8ba04be6c6084e823ed5af7992daf5370a9977a407e85f0310827"},"role":"tester","schema_version":1,"source":"gameloop-vcs.public-role-receipt","source_receipt_sha256":"443b08d05a615921a023c2af14b55bcec95718068200efc1a3cfbffd3c8450ec"}
