[node name="ArenaCamera" type="Camera3D" parent="." groups=["mcp_watch"] node_paths=PackedStringArray("target", "arena_contract")]
process_mode = 1
script = ExtResource("3_camera")
target = NodePath("../Warden")
arena_contract = NodePath("../CemeteryGarden")
near = 0.15
far = 180.0
arena_limit = Vector2(34.0, 32.0)
# Release framing keeps the Warden in the lower-safe lane while exposing the
# native cross-route, perimeter depth, and both landmark silhouettes.
normal_fov = 84.0
follow_height = 16.5
follow_distance = 16.5
# The camera-aware profile keeps the Warden in the lower-safe lane while
# bringing the native mausoleum, cracked bell, keeper post, and an escape lane
# into one readable frame without replacing or hiding the authored package.
follow_lateral = -2.5
framing_bias = Vector3(1.2, 0, -2.4)
arena_fill_limit = Vector2(33.0, 30.5)
coverage_max_correction = 3.5
coverage_threat_weight = 0.18
coverage_radius = 16.0
obstruction_height_boost = 1.2
# Sightline bypass is reserved for explicitly registered tall landmarks.  A
# lateral camera nudge here would make ordinary perimeter/gameplay bodies look
# like occluders again, so keep the serialized scene aligned with the runtime
# visibility contract.
obstruction_lateral_bypass = 0.0
tall_occluders = Array[NodePath]([NodePath("../CemeteryGarden/OuterDatum/NortheastTreeCollision"), NodePath("../CemeteryGarden/OuterDatum/NorthwestTreeCollision"), NodePath("../CemeteryGarden/OuterDatum/SoutheastTreeCollision")])
coverage_occluder_visuals = Array[NodePath]([NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree3"), NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree"), NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree2")])
camera_visibility_collision_mask = 2
require_camera_visibility_blocker_meta = true
