[node name="CemeteryGarden" parent="." instance=ExtResource("4_cemetery")]
# The authored package is calibrated at 1.95x in its native scene.  Keep the
# single intact instance, but give the garden enough street and perimeter
# extent that the camera has a real loop and cross-route instead of a
# camera-sized combat pad.
scale = Vector3(1.95, 1.95, 1.95)

[node name="Warden" parent="." instance=ExtResource("2_warden")]
position = Vector3(0, 0.05, 7.8)

[node name="EncounterSpawner" type="Node3D" parent="." groups=["mcp_watch"] node_paths=PackedStringArray("player", "arena_contract")]
script = ExtResource("5_spawner")
enemy_scene = ExtResource("6_enemy")
profiles = Array[EnemyProfile]([ExtResource("7_moss"), ExtResource("8_bat"), ExtResource("9_slinger"), ExtResource("10_brute")])
