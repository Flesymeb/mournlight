[node name="ArenaCamera" type="Camera3D" parent="." groups=["mcp_watch"] node_paths=PackedStringArray("target", "arena_contract")]
process_mode = 1
script = ExtResource("3_camera")
target = NodePath("../Warden")
arena_contract = NodePath("../CemeteryGarden")
near = 0.15
far = 180.0
arena_limit = Vector2(34.0, 32.0)
# Release framing keeps the Warden in the lower-safe lane while exposing the
# native cross-route, perimeter depth, and both landmark silhouettes.
normal_fov = 78.0
follow_height = 28.0
follow_distance = 26.0
# Keep the camera near the south sight lane. The authored crypt occupies the
# north route; a centered lateral rebase preserves the intact package while
# keeping the player silhouette, keeper post, bell, and escape lanes readable.
follow_lateral = 12.0
# Keep the player in the lower-safe lane while the authored mausoleum and bell
# sit above the route instead of filling the camera's center sight lane.
framing_bias = Vector3(0.0, 0, 5.0)
arena_fill_limit = Vector2(33.0, 30.5)
coverage_max_correction = 3.5
coverage_threat_weight = 0.18
coverage_radius = 16.0
obstruction_height_boost = 1.2
# Sightline bypass is reserved for explicitly registered tall landmarks.  A
# lateral camera nudge here would make ordinary perimeter/gameplay bodies look
# like occluders again, so keep the serialized scene aligned with the runtime
# visibility contract.
obstruction_lateral_bypass = 0.0
dense_compositor_resolution_scale = 0.5
dense_compositor_refresh_seconds = 0.12
presentation_body = NodePath("../Warden/PresentationRoot/ModelPivot/AssetTransform/AuthoredWardenMage")
presentation_lantern = NodePath("../Warden/PresentationRoot/LanternPivot/AuthoredLantern")
presentation_effects = Array[NodePath]([NodePath("../Warden/DashAura"), NodePath("../Warden/ActiveRing"), NodePath("../Warden/WardenHalo")])
tall_occluders = Array[NodePath]([NodePath("../CemeteryGarden/OuterDatum/MausoleumCollision"), NodePath("../CemeteryGarden/OuterDatum/NortheastTreeCollision"), NodePath("../CemeteryGarden/OuterDatum/NorthwestTreeCollision"), NodePath("../CemeteryGarden/OuterDatum/SoutheastTreeCollision")])
coverage_occluder_visuals = Array[NodePath]([NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/Crypt"), NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree3"), NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree"), NodePath("../CemeteryGarden/PackageTransform/AuthoredCemeteryPackage/Sketchfab_model/59eaeb0f852e494285bd67ea8f850a42_fbx/RootNode/DeadTree2"), NodePath("../CemeteryGarden/OuterDatum/CrackedMoonBellAnchor/CrackedBellAsset"), NodePath("../CemeteryGarden/OuterDatum/KeeperLanternPostAnchor/KeeperPostAsset")])
