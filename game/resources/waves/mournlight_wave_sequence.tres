[gd_resource type="Resource" format=3]

[resource]
resource_name = "Mournlight Five-Wave Sequence"
metadata/wave_ids = PackedStringArray("first_toll", "crossing_shadows", "gravewind", "long_procession", "bellkeeper")
metadata/wave_titles = PackedStringArray("The First Toll", "Crossing Shadows", "Gravewind", "The Long Procession", "The Bellkeeper")
# Keep authored pressure bands inside the PRD's seven-to-ten minute
# ordinary-run window.  The first four bands now consume ~410 seconds before
# the Bellkeeper request, so a natural two-phase defeat lands inside the
# terminal 420-600 second qualification window instead of ending early.
metadata/durations = PackedFloat32Array(30, 85, 130, 165, 120)
metadata/live_caps = PackedInt32Array(6, 14, 18, 36, 32)
metadata/cadences = PackedFloat32Array(1.9, 1.15, 0.98, 0.58, 0.48)
metadata/spawn_budgets = PackedInt32Array(22, 46, 60, 120, 128)
metadata/initial_spawns = PackedInt32Array(3, 6, 6, 6, 6)
metadata/mossling_weights = PackedInt32Array(8, 5, 4, 3, 4)
metadata/wispbat_weights = PackedInt32Array(0, 4, 4, 5, 4)
metadata/bone_slinger_weights = PackedInt32Array(0, 1, 3, 4, 3)
metadata/grave_brute_weights = PackedInt32Array(0, 0, 1, 3, 2)
metadata/elite_every = PackedInt32Array(0, 0, 9, 7, 8)
metadata/warnings = PackedStringArray("TEACHING PRESSURE", "FLANK PRESSURE", "RANGED ELITE", "MIXED DENSITY", "FINAL TOLL")
metadata/boss_wave_index = 4
metadata/route_minutes = 8.8
metadata/ordinary_victory_window_seconds = Vector2(420, 600)
# Warmup + first four pressure bands + their intermission handoffs.
metadata/boss_entry_seconds = 414.0
