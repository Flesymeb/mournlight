[resource]
resource_name = "Mournlight Semantic Audio Library"
metadata/music = Array[AudioStream]([ExtResource("1_music")])
# Bind the runtime-facing semantic stems to the deterministic PCM derivatives.
# The retained MP3 recordings remain immutable and are documented by the
# adjacent receipts; Godot's MP3 decoder was silent on the live Effects route,
# while these exact-content encodes are proven audible at the same bus.
metadata/weapon_warden_lantern_onset = Array[AudioStream]([ExtResource("27_lantern_onset_runtime")])
metadata/weapon_warden_lantern_impact = Array[AudioStream]([ExtResource("28_lantern_impact_runtime")])
# The compatibility encodes are retained as the bounded lantern family. The
# anticipation/recovery aliases keep the causal chain audible without adding
# an unrelated tone or replacing the accepted source recordings.
metadata/weapon_warden_lantern_anticipation = Array[AudioStream]([ExtResource("27_lantern_onset_runtime")])
metadata/weapon_warden_lantern_recovery = Array[AudioStream]([ExtResource("28_lantern_impact_runtime")])
